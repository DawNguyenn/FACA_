# Cấu hình Server
PORT=5000

# URL Front-end (dùng tạo link trong email quên mật khẩu)
FRONTEND_URL=http://localhost:5173

# Cấu hình SMTP (Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_PASS phải là "App Password" tạo từ Google Account → Security → 2-Step Verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# JWT Secret (used to sign & verify auth tokens)
JWT_SECRET=faca_library_dawnanime_2026_secure_key

# Cấu hình Database SQL Server
DB_USER=sa
DB_PASSWORD=123456
DB_SERVER=DAWNGUYENN
DB_DATABASE=FACA_DB
DB_PORT=1433