# Cau hinh quet bao cao PowerPoint (OneDrive local -> SQL Server)
# Ten du an + thu muc OneDrive local can quet (dung khi bang dbo.SyncFolders chua co dong active)
ONEDRIVE_PROJECT_NAME=PSM27_Library
ONEDRIVE_LIBRARY_ROOT=C:\Users\laptop\OneDrive - vnua.edu.vn\PSM27_Library
# Thu muc goc OneDrive local (thu muc cha chua cac thu muc du an)
ONEDRIVE_SYNC_ROOT=C:\Users\laptop\OneDrive - vnua.edu.vn
# URL site OneDrive for Business (SharePoint tenant) - dung de dung link TRUC TIEP toi file .pptx
# LUU Y: alias phai la TAI KHOAN OneDrive DANG DONG BO tren may
#   (kiem tra: HKCU\SOFTWARE\Microsoft\OneDrive\Accounts\Business1 -> ServiceEndpointUri)
#   dat_vnua_edu_vn KHONG ton tai (HTTP 404) => phai dung 671279_sv_vnua_edu_vn
SHAREPOINT_TENANT_BASE=https://vnuaeduvn-my.sharepoint.com/personal/671279_sv_vnua_edu_vn/Documents
# (Tuy chon) Ghi de toan bo prefix thu muc du an; thuong de trong de dung SHAREPOINT_TENANT_BASE
# SHAREPOINT_URL_PREFIX=https://vnuaeduvn-my.sharepoint.com/personal/671279_sv_vnua_edu_vn/Documents/PSM27_Library
# (Tuy chon) Anh xa thu muc con la THU MUC CHIA SE (shortcut tren OneDrive nguoi khac) -
# dang JSON: [{"local":"<duong dan con tinh tu goc du an>","remote":"<URL thu muc truc tiep>"}]
# Nguon chinh la bang dbo.SyncFolderMappings (xem sql/add_sync_folder_mappings.sql);
# bien nay chi dung khi muon ghi de nhanh ma khong can sua DB.
# SHAREPOINT_PATH_MAP=[{"local":"Tệp của Phạm Trung Hiếu - ME","remote":"https://vnuaeduvn-my.sharepoint.com/personal/671445_sv_vnua_edu_vn/Documents/PSM27 Library/ME"}]
