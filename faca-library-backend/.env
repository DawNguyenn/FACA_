# Cấu hình Server
PORT=5000

# JWT Secret 
JWT_SECRET=faca_library_2026_secure_key

# Cấu hình Database SQL Server
DB_USER=sa
DB_PASSWORD=123456
DB_SERVER=DAWNGUYENN
DB_DATABASE=FACA_DB
DB_PORT=1433

# Cấu hình Email gửi OTP khi người dùng click vào quên mật khẩu
# (EMAIL_USER/EMAIL_PASS là tên biến CŨ — mailer.js đọc SMTP_USER/SMTP_PASS trước,
#  không thấy thì mới dùng các biến này nên cấu hình cũ vẫn hoạt động)
EMAIL_USER=nguyenhuudatbg18@gmail.com
EMAIL_PASS=dphl ssbr doeh gatk

# =============================================================
# CẤU HÌNH SMTP / GỬI MAIL (mạng nội bộ doanh nghiệp)
# =============================================================
# Cổng 587 = STARTTLS (secure=false) — đã xác nhận mở trong mạng công ty.
# Cổng dự phòng khi 587 bị throttle/nuốt gói tin: 465 (implicit SSL), 2525.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=nguyenhuudatbg18@gmail.com
SMTP_PASS=dphl ssbr doeh gatk
# FROM phải cùng domain với SMTP_USER (khác là bị cục lọc spam doanh nghiệp drop)
SMTP_FROM="FACA Library Support" <nguyenhuudatbg18@gmail.com>
SMTP_FALLBACK_PORTS=465,2525

# Timeout (ms) — chống treo API khi firewall nuốt gói tin im lặng
SMTP_CONNECTION_TIMEOUT=10000
SMTP_GREETING_TIMEOUT=10000
SMTP_SOCKET_TIMEOUT=15000
SMTP_BANNER_TIMEOUT=10000

# TLS: false = chấp nhận cert tự ký của proxy nội bộ (KHÔNG bật trên internet
# công khai — đổi lại true khi không còn đi qua proxy MITM)
SMTP_TLS_REJECT_UNAUTHORIZED=false
# Tuỳ chọn nâng cao (chỉ set khi chắc chắn — KHÔNG dùng SSLv3, Node đã tắt):
# SMTP_TLS_MIN_VERSION=TLSv1.2
# SMTP_TLS_CIPHERS=DEFAULT@SECLEVEL=1

# Chế độ gửi: queue (bất đồng bộ + retry, mặc định) | sync (đồng bộ, 500 khi lỗi)
MAIL_DELIVERY_MODE=queue
MAIL_QUEUE_CONCURRENCY=2
MAIL_QUEUE_MAX_ATTEMPTS=3
MAIL_QUEUE_RETRY_BASE_MS=5000
MAIL_QUEUE_RETRY_MAX_MS=60000
# Kiểm tra kết nối SMTP mỗi lần khởi động server (log chi tiết)
MAIL_VERIFY_ON_STARTUP=true
# true = log hội thoại SMTP thô khi chẩn đoán sâu
SMTP_DEBUG=false

# --- Fallback REST qua HTTPS 443 (điền API key để kích hoạt) ---
# REST API hiếm khi bị firewall doanh nghiệp chặn hơn SMTP trực tiếp.
RESEND_API_KEY=
SENDGRID_API_KEY=
REST_TIMEOUT_MS=15000
# Selector DKIM dùng khi chạy `npm run test:smtp` kiểm tra record DKIM
DKIM_SELECTOR=default

# Cau hinh quet bao cao PowerPoint (OneDrive local -> SQL Server)
# Ten du an + thu muc OneDrive local can quet (dung khi bang dbo.SyncFolders chua co dong active)
ONEDRIVE_PROJECT_NAME=PSM27_Library
ONEDRIVE_LIBRARY_ROOT=C:\Users\laptop\OneDrive - vnua.edu.vn\PSM27_Library
# Thu muc goc OneDrive local (thu muc cha chua cac thu muc du an)
ONEDRIVE_SYNC_ROOT=C:\Users\laptop\OneDrive - vnua.edu.vn
# URL site OneDrive for Business (SharePoint tenant) - dung de dung link TRUC TIEP toi file .pptx
# LUU Y: alias phai la TAI KHOAN OneDrive DANG DONG BO tren may
#   (kiem tra: HKCU\SOFTWARE\Microsoft\OneDrive\Accounts\Business1 -> ServiceEndpointUri)
#   dat_vnua_edu_vn KHONG ton tai (HTTP 404) => phai dung 671279_sv_vnua_edu_vn
SHAREPOINT_TENANT_BASE=https://vnuaeduvn-my.sharepoint.com/personal/671279_sv_vnua_edu_vn/Documents
# (Tuy chon) Ghi de toan bo prefix thu muc du an; thuong de trong de dung SHAREPOINT_TENANT_BASE
# SHAREPOINT_URL_PREFIX=https://vnuaeduvn-my.sharepoint.com/personal/671279_sv_vnua_edu_vn/Documents/PSM27_Library
# (Tuy chon) Anh xa thu muc con la THU MUC CHIA SE (shortcut tren OneDrive nguoi khac) -
# dang JSON: [{"local":"<duong dan con tinh tu goc du an>","remote":"<URL thu muc truc tiep>"}]
# Nguon chinh la bang dbo.SyncFolderMappings (xem sql/add_sync_folder_mappings.sql);
# bien nay chi dung khi muon ghi de nhanh ma khong can sua DB.
# SHAREPOINT_PATH_MAP=[{"local":"Tệp của Phạm Trung Hiếu - ME","remote":"https://vnuaeduvn-my.sharepoint.com/personal/671445_sv_vnua_edu_vn/Documents/PSM27 Library/ME"}]
